{
  "id": "/",
  "name": "Hentity",
  "short_name": "Hentity",
  "description": "Discover the best new products built by African makers, find funding, co-founders and beta testers. A fresh launch board every Monday.",
  "lang": "en-GB",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "categories": ["business", "productivity", "news"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg?v=3", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Launch a product", "short_name": "Launch", "url": "/submit?source=pwa", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Funding", "url": "/funding?source=pwa", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Find co-founders and roles", "short_name": "Find", "url": "/find?source=pwa", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Saved", "url": "/saved?source=pwa", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "screenshots": [
    { "src": "/icons/screen-mobile.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "Funding matched to your product" },
    { "src": "/icons/screen-wide.png", "sizes": "2560x1600", "type": "image/png", "form_factor": "wide", "label": "Funding matched to your product" }
  ]
}
