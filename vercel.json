{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 build.py",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/badges/:slug/:file",
      "destination": "/api/badge?slug=:slug&file=:file"
    },
    {
      "source": "/directory",
      "destination": "/api/ssr?type=directory&slug=all"
    },
    {
      "source": "/categories/:slug",
      "destination": "/api/ssr?type=category&slug=:slug"
    },
    {
      "source": "/countries/:slug",
      "destination": "/api/ssr?type=country&slug=:slug"
    },
    {
      "source": "/b/:slug",
      "destination": "/api/ssr?type=beta&slug=:slug"
    },
    {
      "source": "/go/b/:token",
      "destination": "/api/go?t=:token"
    },
    {
      "source": "/find/people",
      "destination": "/find"
    },
    {
      "source": "/find/matches",
      "destination": "/find"
    },
    {
      "source": "/find/roles/:id",
      "destination": "/find-role"
    },
    {
      "source": "/find/post",
      "destination": "/find-post"
    },
    {
      "source": "/find/open",
      "destination": "/find-open"
    },
    {
      "source": "/find/m/:id",
      "destination": "/find-match"
    },
    {
      "source": "/find/privacy",
      "destination": "/find-privacy"
    },
    {
      "source": "/validate/:id",
      "destination": "/validate"
    },
    {
      "source": "/claim/:slug",
      "destination": "/claim"
    },
    {
      "source": "/studio/:product/:beta",
      "destination": "/studio"
    },
    {
      "source": "/studio/:product",
      "destination": "/studio"
    },
    {
      "source": "/betas/:id/manage",
      "destination": "/beta-manage"
    },
    {
      "source": "/betas/:id",
      "destination": "/beta"
    },
    {
      "source": "/news",
      "destination": "/api/ssr?type=news"
    },
    {
      "source": "/",
      "destination": "/api/ssr?type=home"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/products/:slug/edit",
      "destination": "/product-edit"
    },
    {
      "source": "/products/:slug",
      "destination": "/api/ssr?type=product&slug=:slug"
    },
    {
      "source": "/makers/:handle",
      "destination": "/api/ssr?type=maker&slug=:handle"
    },
    {
      "source": "/news/:slug",
      "destination": "/api/ssr?type=article&slug=:slug"
    },
    {
      "source": "/chats/:path*",
      "destination": "/chats"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "hentity.vercel.app"
        }
      ],
      "destination": "https://hentity.com/:path*",
      "permanent": true
    },
    {
      "source": "/settings",
      "destination": "/settings/profile",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/signin",
      "permanent": true
    },
    {
      "source": "/register",
      "destination": "/signup",
      "permanent": true
    },
    {
      "source": "/launches",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/community",
      "destination": "/guidelines",
      "permanent": false
    },
    {
      "source": "/forgot-password",
      "destination": "/signin",
      "permanent": true
    },
    {
      "source": "/reset-password",
      "destination": "/signin",
      "permanent": true
    },
    {
      "source": "/check-email",
      "destination": "/signin",
      "permanent": true
    },
    {
      "source": "/link-expired",
      "destination": "/signin?expired=1",
      "permanent": true
    },
    {
      "source": "/betas",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/betas/new",
      "destination": "/studio",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(self)"
        }
      ]
    },
    {
      "source": "/((?!insights).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/insights",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        }
      ]
    }
  ],
  "regions": [
    "lhr1"
  ],
  "functions": {
    "api/ssr.js": {
      "includeFiles": "public/{product,maker,article,404,home,news-index,beta-apply,directory-index}.html",
      "maxDuration": 10
    },
    "api/sitemap.js": {
      "maxDuration": 10
    },
    "api/badge.js": {
      "maxDuration": 10
    },
    "api/health.js": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/indexnow",
      "schedule": "30 6 * * *"
    }
  ]
}