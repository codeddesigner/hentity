{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 build.py",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/products/:slug",
      "destination": "/api/ssr?type=product&slug=:slug"
    },
    {
      "source": "/makers/:handle",
      "destination": "/api/ssr?type=maker&slug=:handle"
    },
    {
      "source": "/news/:slug",
      "destination": "/api/ssr?type=article&slug=:slug"
    },
    {
      "source": "/chats/:path*",
      "destination": "/chats"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "hentity.vercel.app"
        }
      ],
      "destination": "https://hentity.com/:path*",
      "permanent": true
    },
    {
      "source": "/settings",
      "destination": "/settings/profile",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/signin",
      "permanent": true
    },
    {
      "source": "/register",
      "destination": "/signup",
      "permanent": true
    },
    {
      "source": "/launches",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/community",
      "destination": "/guidelines",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/forgot-password",
      "destination": "/signin",
      "permanent": true
    },
    {
      "source": "/reset-password",
      "destination": "/signin",
      "permanent": true
    },
    {
      "source": "/check-email",
      "destination": "/signin",
      "permanent": true
    },
    {
      "source": "/link-expired",
      "destination": "/signin?expired=1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(self)"
        }
      ]
    }
  ],
  "regions": [
    "lhr1"
  ],
  "functions": {
    "api/ssr.js": {
      "includeFiles": "public/{product,maker,article,404}.html",
      "maxDuration": 10
    },
    "api/sitemap.js": {
      "maxDuration": 10
    },
    "api/badge.js": {
      "maxDuration": 10
    },
    "api/health.js": {
      "maxDuration": 10
    }
  }
}